# ---- core -------------------------------------------------------------------
# host port published by docker compose (the container always listens on 9999)
HOST_PORT=9999

# shared secret with the GMod server (sv_streamradio_converter_secret).
# REQUIRED - the server refuses to start with an empty/placeholder value.
# generate one with:  openssl rand -hex 32
API_SECRET=

# set to 1 only if the server sits behind a reverse proxy (nginx, caddy, ...)
TRUST_PROXY=0

# ---- cache / limits -----------------------------------------------------------
# days a track stays cached after its LAST play (sliding expiry)
CACHE_DAYS=30
# evict least recently used tracks above this size, 0 = unlimited
MAX_CACHE_SIZE_MB=0
# delete play history older than this, 0 = keep forever
HISTORY_DAYS=90
# default max track length for ranks without their own limit, 0 = unlimited
MAX_DURATION_SECONDS=600
# max entries returned for a playlist
MAX_PLAYLIST_ITEMS=500

# expensive work (fresh conversions, lookups) per player/IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
# same, for GMod-server requests that carry no player
RATE_LIMIT_SERVER_MAX=120

# ---- worker pool -----------------------------------------------------------------
# parallel yt-dlp+ffmpeg jobs (CPU bound, ~1 per core is a good start)
MAX_CONCURRENT_CONVERSIONS=3
# jobs allowed to wait for a worker before the API answers 503 BUSY
MAX_QUEUED_CONVERSIONS=50
# parallel metadata/search/playlist lookups
MAX_CONCURRENT_META=6
CONVERSION_TIMEOUT_SECONDS=300

# ---- yt-dlp --------------------------------------------------------------------
# VBR quality 0 (best, ~245kbps) .. 9 (worst). 5 = ~130kbps, fine for GMod
AUDIO_QUALITY=5
# yt-dlp format selector for the source audio
AUDIO_FORMAT=bestaudio[abr<=192]/bestaudio/best
# auto | off | explicit target like chrome-133
YTDLP_IMPERSONATE=auto
# JS runtime for YouTube challenges (node is bundled in the image)
YTDLP_JS_RUNTIME=node
# 1 = pip install -U yt-dlp on every container start
YTDLP_AUTO_UPDATE=0
# netscape cookies file (mounted read-only from ./cookies)
COOKIES_FILE=/app/cookies/cookies.txt

# ---- GMod client tokens ------------------------------------------------------------
# clients authenticate with short-lived HMAC tokens signed by the GMod server,
# so API_SECRET no longer has to be replicated to every player
CLIENT_TOKENS=1
CLIENT_TOKEN_MAX_TTL_SECONDS=86400

# ---- spotify (optional) ---------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- dev console ------------------------------------------------------------------
# DEV_CONSOLE=1 enables /dev; the token must be >= 12 chars
DEV_CONSOLE=0
DEV_CONSOLE_TOKEN=

# ---- logging --------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# text | json
LOG_FORMAT=text
